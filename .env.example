# Copie para .env e preencha os valores reais.

# Chave PASETO v4.local, 32 bytes em hex (`openssl rand -hex 32`), a mesma do auth-service
PASETO_LOCAL_KEY=CHANGE_ME

# URLs de destino do roteamento
AUTH_SERVICE_URL=http://localhost:8081
BETS_SERVICE_URL=http://localhost:8082
STATS_SERVICE_URL=http://localhost:8083

# Credencial X-Service-Key, a mesma do telegram-integration
SERVICE_KEY=CHANGE_ME

# Origens CORS liberadas, separadas por virgula
#CORS_ALLOWED_ORIGINS=http://localhost:4200
